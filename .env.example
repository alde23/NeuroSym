# ==============================================================================
# NeuroSym Environment Configuration
# ==============================================================================

# LLM Providers (Primary & Failover Pools)
# You can provide single keys or comma-separated lists of backup keys:
# e.g. GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=your_primary_gemini_key
GEMINI_API_KEYS=

# Secondary Fast Failover (Free 30 RPM from console.groq.com)
GROQ_API_KEY=your_groq_key
GROQ_API_KEYS=

# Additional Providers (Optional)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Database & Storage
CORDIS_DB_PATH=cordis.duckdb

# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
DEBUG=false
